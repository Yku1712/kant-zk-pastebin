[Unit]
Description=Kant Pastebin Beta (commit 2c34cea268448c3bfd0ca11a11281a7cc29d3364)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/kant/pastebin
ExecStart=/mnt/data1/kant/pastebin/target/release/kant-pastebin --bind 0.0.0.0 --port 8084
Restart=always
RestartSec=10
Environment="UUCP_SPOOL=/mnt/data1/spool/uucp/pastebin"
Environment="BASE_PATH=/pastebin/beta"
Environment="BASE_URL=https://solana.solfunmeme.com"
Environment="RUST_LOG=info"
Environment="GIT_COMMIT=2c34cea268448c3bfd0ca11a11281a7cc29d3364"
Environment="BUILD_TIME=2026-10-20T14:23:28Z"
TimeoutStartSec=0
TimeoutStopSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
