+fn write_block(
+    repo: &std::path::Path,
+    cid: &impl std::fmt::Display,
+    block: &[u8],
+) -> std::io::Result<()> {
+    use std::io::{Error, ErrorKind, Write};
+
+    let local_cid: Cid = cid
+        .to_string()
+        .parse()
+        .map_err(|error| Error::new(ErrorKind::InvalidData, error))?;
+    let key = data_encoding::BASE32_NOPAD.encode(&local_cid.hash().to_bytes());
+    let shard = key
+        .len()
+        .checked_sub(3)
+        .map_or("AA", |start| &key[start..start + 2]);
+    let dir = repo.join("blocks").join(shard);
+    std::fs::create_dir_all(&dir)?;
+
+    // Publish a completed block at the flatfs name in one rename.
+    let path = dir.join(format!("{key}.data"));
+    let mut temp = tempfile::NamedTempFile::new_in(&dir)?;
+    temp.write_all(block)?;
+    temp.persist(&path).map_err(|error| error.error)?;
+    log::info!("📦 IPFS block: {}", path.display());
+    Ok(())
 }
 
